{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: app IPC only. No filesystem, shell, dialog, or HTTP access is granted to the webview.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "allow-conversations-list",
    "allow-conversations-create",
    "allow-conversations-rename",
    "allow-conversations-set-project",
    "allow-conversations-delete",
    "allow-conversations-delete-all",
    "allow-messages-list",
    "allow-messages-append",
    "allow-projects-list",
    "allow-projects-create",
    "allow-projects-update",
    "allow-projects-delete",
    "allow-documents-list",
    "allow-documents-import",
    "allow-documents-set-project",
    "allow-documents-remove",
    "allow-documents-reveal",
    "allow-settings-load",
    "allow-settings-save",
    "allow-app-info",
    "allow-app-reveal-data-dir",
    "allow-ai-providers",
    "allow-ai-stream-chat",
    "allow-ai-cancel"
  ]
}
